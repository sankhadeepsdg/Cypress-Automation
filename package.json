{
  "name": "actyvate_cypress",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cypress open",
    "test": "cypress run",
    "allure:clean": "rm -rf allure-results allure-report",
    "test:allure": "npm run allure:clean && cypress run",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure-report": "npm run test:allure && npm run allure:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "open": "^11.0.0",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "allure-commandline": "^2.43.0",
    "allure-cypress": "^3.10.2",
    "cypress": "^15.14.1"
  }
}
